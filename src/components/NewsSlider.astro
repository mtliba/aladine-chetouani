---
// News carousel: picture + headline slides, arrows, dots, swipe, keyboard,
// and a pause button (auto-advance every 7 s, off with reduced motion).
import { t, withBase, formatDate, type Lang } from '../lib/i18n';
import type { FeedItem } from '../lib/newsfeed';

interface Props { lang: Lang; items: FeedItem[] }
const { lang, items } = Astro.props;
const s = t(lang);
const total = items.length;
// Figures carry their own label; photos get the word "Photo" in front.
const credit = (c: string) => (!c ? '' : /^(figure|fig\.|photo|image)/i.test(c) ? c : `${s.photo}${lang === 'fr' ? ' : ' : ': '}${c}`);
---
{total > 0 && (
  <div class="nslider" data-slider role="region" aria-roledescription="carousel" aria-label={s.slider_label}>
    <div class="nslider__track" data-track>
      {items.map((it, i) => (
        <article class="nslide" data-slide role="group" aria-roledescription="slide" aria-label={s.slide_of(i + 1, total)}>
          <figure class="nslide__media">
            <img src={withBase(it.image)} alt={it.imageAlt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" width="1200" height="800" />
            {it.credit && <figcaption>{credit(it.credit)}</figcaption>}
          </figure>
          <p class="nslide__meta"><time datetime={it.date}>{formatDate(it.date, lang)}</time> · {it.kind}</p>
          <h3 class="nslide__title">{it.link ? <a href={it.link} rel={it.external ? 'noopener' : undefined}>{it.title}</a> : it.title}</h3>
          {it.summary && <p class="nslide__summary">{it.summary}</p>}
        </article>
      ))}
    </div>
    {total > 1 && (
      <div class="nslider__controls">
        <button class="round-btn" type="button" data-prev aria-label={s.prev}><span aria-hidden="true">←</span></button>
        <div class="nslider__dots">
          {items.map((_, i) => (
            <button class="dot" type="button" data-dot={i} aria-label={s.go_to_slide(i + 1)} aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </div>
        <button class="round-btn" type="button" data-next aria-label={s.next}><span aria-hidden="true">→</span></button>
        <button class="round-btn round-btn--plain" type="button" data-toggle aria-label={s.pause} data-label-pause={s.pause} data-label-play={s.play}>
          <span class="i-pause" aria-hidden="true">❚❚</span><span class="i-play" aria-hidden="true">▶</span>
        </button>
      </div>
    )}
  </div>
)}

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    if (!track || slides.length < 2) return;
    let index = 0;
    let userPaused = reduce;
    let hovering = false;
    let timer = 0;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: index * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };
    const sync = () => {
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      index = Math.min(slides.length - 1, Math.max(0, i));
      dots.forEach((d, k) => (k === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      slides.forEach((sl, k) => sl.toggleAttribute('inert', k !== index));
    };
    const schedule = () => {
      window.clearInterval(timer);
      if (!userPaused && !hovering && document.visibilityState === 'visible') timer = window.setInterval(() => go(index + 1), 7000);
    };
    const renderToggle = () => {
      if (!toggle) return;
      toggle.classList.toggle('is-paused', userPaused);
      toggle.setAttribute('aria-label', (userPaused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) || '');
    };

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    }, { passive: true });
    root.querySelector('[data-prev]')?.addEventListener('click', () => { go(index - 1); schedule(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { go(index + 1); schedule(); });
    dots.forEach((d, k) => d.addEventListener('click', () => { go(k); schedule(); }));
    toggle?.addEventListener('click', () => { userPaused = !userPaused; renderToggle(); schedule(); });
    root.addEventListener('pointerenter', () => { hovering = true; schedule(); });
    root.addEventListener('pointerleave', () => { hovering = false; schedule(); });
    root.addEventListener('focusin', () => { hovering = true; schedule(); });
    root.addEventListener('focusout', () => { hovering = false; schedule(); });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { go(index + 1); schedule(); }
      if (e.key === 'ArrowLeft') { go(index - 1); schedule(); }
    });
    document.addEventListener('visibilitychange', schedule);
    window.addEventListener('resize', () => track.scrollTo({ left: index * track.clientWidth }));
    sync();
    renderToggle();
    schedule();
  });
</script>
