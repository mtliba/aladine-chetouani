---
import Section from '../Section.astro';
import { t, pick, type Lang } from '../../lib/i18n';
import { getTeam } from '../../lib/content';

interface Props { lang: Lang; title: string; n?: number }
const { lang, title, n } = Astro.props;
const s = t(lang);
const team = getTeam();
const members: any[] = team.members || [];
const current = [
  ...members.filter((m) => m.role === 'phd' && m.status === 'current'),
  ...members.filter((m) => m.role !== 'phd' && m.status === 'current'),
];
const alumni = members.filter((m) => m.role === 'phd' && m.status === 'alumni').sort((a, b) => String(b.years).localeCompare(String(a.years)));
const roleLabel = (m: any) => (m.role === 'phd' ? '' : m.role === 'postdoc' ? (lang === 'fr' ? 'Post-doctorant' : 'Postdoc') : m.role === 'engineer' ? (lang === 'fr' ? 'Ingénieur' : 'Engineer') : '');
const groups = [
  { label: lang === 'fr' ? 'Équipe actuelle' : 'Current team', list: current },
  { label: s.phd_alumni, list: alumni },
].filter((g) => g.list.length);
---
<Section id="team" title={title} intro={pick(team, 'intro', lang)} n={n}>
  <div class="people-grid">
    {groups.map((g) => (
      <div class="people">
        <h3>{g.label} <span class="num muted">({g.list.length})</span></h3>
        <ul class="person-list">
          {g.list.map((m) => (
            <li class="person">
              <div>
                <p class="person__name">{m.link ? <a href={m.link} rel="noopener">{m.name}</a> : m.name}{m.years && <span class="num"> · {m.years}</span>}{roleLabel(m) && <span class="tag tag--plain person__role">{roleLabel(m)}</span>}</p>
                {pick(m, 'topic', lang) && <p class="person__topic">{pick(m, 'topic', lang)}</p>}
                {m.with && <p class="person__with">{s.with} {m.with}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
