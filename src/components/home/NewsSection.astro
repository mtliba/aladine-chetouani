---
import Section from '../Section.astro';
import NewsSlider from '../NewsSlider.astro';
import { t, href, formatDate, type Lang } from '../../lib/i18n';
import { getFeed } from '../../lib/newsfeed';

interface Props { lang: Lang; title: string; n?: number }
const { lang, title } = Astro.props;
const s = t(lang);
const feed = getFeed(lang);
// Items with a picture slide at the top; the others follow as a short dated list.
const slides = feed.filter((it) => it.image).slice(0, 6);
const brief = feed.filter((it) => !slides.includes(it)).slice(0, 5);
---
<Section id="news" title={title} moreHref={href(lang, 'news/')} moreLabel={s.all_news}>
  {feed.length === 0 && <p class="empty">{s.news_empty}</p>}
  <NewsSlider lang={lang} items={slides} />
  {brief.length > 0 && (
    <ul class="dated">
      {brief.map((it) => (
        <li>
          <time datetime={it.date}>{formatDate(it.date, lang, 'month')}</time>
          <p>{it.link ? <a href={it.link} rel={it.external ? 'noopener' : undefined}>{it.title}</a> : it.title}</p>
        </li>
      ))}
    </ul>
  )}
</Section>
