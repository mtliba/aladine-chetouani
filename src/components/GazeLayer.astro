---
// Eye-tracking demo: the cursor stands in for the reader's gaze. Pauses become
// numbered fixations (circle size = dwell time), jumps become saccade lines, and
// the accumulated dwell can be shown as a classic attention heatmap.
// Desktop pointers only; nothing is stored or sent anywhere.
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const tpl = (fn: (a: number, b: number) => string) => fn('{a}' as unknown as number, '{b}' as unknown as number);
---
<canvas class="gaze-canvas" data-gaze-canvas aria-hidden="true"
  data-stats={tpl(s.gaze_stats)} data-caption={tpl(s.gaze_caption)} data-empty={s.gaze_empty}></canvas>
<div class="heat" data-heat hidden>
  <canvas class="heat__canvas" data-heat-canvas aria-hidden="true"></canvas>
</div>
<div class="heat__panel" data-heat-panel role="status" hidden>
  <p class="heat__scale" aria-hidden="true"><span>{lang === 'fr' ? 'bref' : 'brief'}</span><span class="heat__ramp"></span><span>{lang === 'fr' ? 'long' : 'long'}</span></p>
  <p class="heat__caption" data-heat-caption></p>
  <button class="tool" type="button" data-heat-close>{s.gaze_close}</button>
</div>

<script>
  type Fix = { x: number; y: number; start: number; end: number; n: number };
  type Live = { x: number; y: number; sx: number; sy: number; k: number; start: number };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-gaze-canvas]');
  const ctl = document.querySelector<HTMLElement>('[data-gaze-ctl]');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (canvas && ctl && finePointer) {
    const ctx = canvas.getContext('2d')!;
    const toggle = ctl.querySelector<HTMLButtonElement>('[data-gaze-toggle]')!;
    const heatBtn = ctl.querySelector<HTMLButtonElement>('[data-gaze-heatmap]')!;
    const stats = ctl.querySelector<HTMLElement>('[data-gaze-stats]')!;
    const heat = document.querySelector<HTMLElement>('[data-heat]')!;
    const heatCanvas = document.querySelector<HTMLCanvasElement>('[data-heat-canvas]')!;
    const panel = document.querySelector<HTMLElement>('[data-heat-panel]')!;
    const caption = document.querySelector<HTMLElement>('[data-heat-caption]')!;
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-heat-close]')!;
    const fill = (tpl: string, a: number | string, b: number | string) => tpl.replace('{a}', String(a)).replace('{b}', String(b));

    const RADIUS = 34; // px: cursor samples within this disc belong to one fixation
    const MIN_FIX = 110; // ms: shorter pauses are part of a saccade
    const LIFE = 6500; // ms: a finished fixation fades out over this time
    const SHOWN = 9; // fixations drawn at once
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let enabled = !reduceMotion;
    try {
      const saved = localStorage.getItem('gaze');
      if (saved === 'on' || saved === 'off') enabled = saved === 'on';
    } catch { /* storage unavailable */ }

    const fixations: Fix[] = [];
    let live: Live | null = null;
    let count = 0;
    let lastClient: { x: number; y: number } | null = null;
    let heatOpen = false;
    let raf = 0;
    let dpr = 1;
    let W = 0;
    let H = 0;
    const startedAt = performance.now();
    const rgb = () => getComputedStyle(document.documentElement).getPropertyValue('--gaze-rgb').trim() || '163 35 58';

    const resize = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      kick();
    };

    const radius = (dur: number) => 7 + Math.sqrt(Math.min(dur, 1600)) * 0.5;

    const updateStats = () => {
      const durs = fixations.map((f) => f.end - f.start);
      const mean = durs.length ? Math.round(durs.reduce((a, b) => a + b, 0) / durs.length) : 0;
      stats.textContent = fill(canvas.dataset.stats || '', count, mean);
    };

    const closeLive = (now: number) => {
      if (live && now - live.start >= MIN_FIX) {
        count += 1;
        fixations.push({ x: live.x, y: live.y, start: live.start, end: now, n: count });
        if (fixations.length > 2000) fixations.shift();
        updateStats();
      }
      live = null;
    };

    const sample = (x: number, y: number) => {
      const now = performance.now();
      if (live) {
        if (Math.hypot(x - live.x, y - live.y) <= RADIUS) {
          live.sx += x; live.sy += y; live.k += 1;
          live.x = live.sx / live.k; live.y = live.sy / live.k;
          kick();
          return;
        }
        closeLive(now);
      }
      live = { x, y, sx: x, sy: y, k: 1, start: now };
      kick();
    };

    const frame = (now: number) => {
      raf = 0;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      if (!enabled || heatOpen) return;
      const color = rgb();
      const ox = window.scrollX;
      const oy = window.scrollY;
      const items = fixations
        .slice(-SHOWN)
        .filter((f) => now - f.end < LIFE)
        .map((f) => ({ x: f.x, y: f.y, n: f.n, dur: f.end - f.start, a: 1 - (now - f.end) / LIFE }));
      const pending = live && now - live.start >= MIN_FIX;
      if (live && pending) items.push({ x: live.x, y: live.y, n: count + 1, dur: now - live.start, a: 1 });

      ctx.lineWidth = 1.4;
      for (let i = 1; i < items.length; i += 1) {
        const p = items[i - 1];
        const q = items[i];
        if (q.n !== p.n + 1) continue;
        const dx = q.x - p.x;
        const dy = q.y - p.y;
        const d = Math.hypot(dx, dy);
        const rp = radius(p.dur);
        const rq = radius(q.dur);
        if (d <= rp + rq) continue;
        const ux = dx / d;
        const uy = dy / d;
        ctx.strokeStyle = `rgb(${color} / ${0.6 * Math.min(p.a, q.a)})`;
        ctx.beginPath();
        ctx.moveTo(p.x - ox + ux * rp, p.y - oy + uy * rp);
        ctx.lineTo(q.x - ox - ux * rq, q.y - oy - uy * rq);
        ctx.stroke();
      }
      ctx.font = '600 10px "Atkinson Hyperlegible Next Variable", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      for (const f of items) {
        const r = radius(f.dur);
        const x = f.x - ox;
        const y = f.y - oy;
        if (y < -r || y > H + r) continue;
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgb(${color} / ${0.13 * f.a})`;
        ctx.fill();
        ctx.strokeStyle = `rgb(${color} / ${0.75 * f.a})`;
        ctx.stroke();
        ctx.fillStyle = `rgb(${color} / ${0.95 * f.a})`;
        ctx.fillText(String(f.n), x, y + 0.5);
      }
      if (items.length || live) kick();
    };

    function kick() {
      if (!raf) raf = requestAnimationFrame(frame);
    }

    // Attention heatmap: Gaussian dwell density over the whole page, 1/4 resolution.
    const openHeat = () => {
      closeLive(performance.now());
      const seconds = Math.round((performance.now() - startedAt) / 1000);
      heatOpen = true;
      kick();
      panel.hidden = false;
      if (fixations.length < 4) {
        caption.textContent = canvas.dataset.empty || '';
        heat.hidden = true;
        closeBtn.focus();
        return;
      }
      const doc = document.documentElement;
      const PW = doc.scrollWidth;
      const PH = doc.scrollHeight;
      const k = 0.25;
      const w = Math.ceil(PW * k);
      const h = Math.ceil(PH * k);
      const grid = new Float32Array(w * h);
      const sigma = 46 * k;
      const reach = Math.ceil(sigma * 3);
      let max = 0;
      for (const f of fixations) {
        const weight = Math.min(f.end - f.start, 3000);
        const cx = f.x * k;
        const cy = f.y * k;
        const x0 = Math.max(0, Math.floor(cx - reach));
        const x1 = Math.min(w - 1, Math.ceil(cx + reach));
        const y0 = Math.max(0, Math.floor(cy - reach));
        const y1 = Math.min(h - 1, Math.ceil(cy + reach));
        for (let y = y0; y <= y1; y += 1) {
          for (let x = x0; x <= x1; x += 1) {
            const d2 = (x - cx) ** 2 + (y - cy) ** 2;
            const v = (grid[y * w + x] += weight * Math.exp(-d2 / (2 * sigma * sigma)));
            if (v > max) max = v;
          }
        }
      }
      // Colour ramp: green, yellow, red, as in eye-tracking software.
      const stops = [
        [0, 46, 160, 88],
        [0.5, 245, 205, 48],
        [1, 214, 39, 40],
      ];
      heatCanvas.width = w;
      heatCanvas.height = h;
      heat.style.width = `${PW}px`;
      heat.style.height = `${PH}px`;
      const hctx = heatCanvas.getContext('2d')!;
      const img = hctx.createImageData(w, h);
      for (let i = 0; i < grid.length; i += 1) {
        const v = grid[i] / max;
        if (v < 0.04) continue;
        const j = v < 0.5 ? 0 : 1;
        const tt = (v - stops[j][0]) / (stops[j + 1][0] - stops[j][0]);
        const o = i * 4;
        for (let c = 1; c <= 3; c += 1) img.data[o + c - 1] = stops[j][c] + (stops[j + 1][c] - stops[j][c]) * tt;
        img.data[o + 3] = Math.round(255 * Math.min(0.68, (v - 0.04) * 1.6));
      }
      hctx.putImageData(img, 0, 0);
      heat.hidden = false;
      caption.textContent = fill(canvas.dataset.caption || '', fixations.length, seconds);
      closeBtn.focus();
    };

    const closeHeat = () => {
      if (!heatOpen) return;
      heatOpen = false;
      heat.hidden = true;
      panel.hidden = true;
      heatBtn.focus({ preventScroll: true });
      kick();
    };

    const invite = document.querySelector<HTMLElement>('[data-gaze-invite]');
    if (invite) invite.hidden = false;
    const setEnabled = (on: boolean, persist = true) => {
      enabled = on;
      if (invite) {
        invite.querySelector<HTMLElement>('[data-on]')!.hidden = !on;
        invite.querySelector<HTMLElement>('[data-off]')!.hidden = on;
        invite.classList.toggle('is-off', !on);
      }
      toggle.setAttribute('aria-checked', String(on));
      heatBtn.disabled = !on;
      if (!on) { live = null; closeHeat(); }
      if (persist) {
        try { localStorage.setItem('gaze', on ? 'on' : 'off'); } catch { /* storage unavailable */ }
      }
      kick();
    };

    ctl.hidden = false;
    setEnabled(enabled, false);
    updateStats();
    resize();

    window.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      lastClient = { x: e.clientX, y: e.clientY };
      if (enabled && !heatOpen) sample(e.pageX, e.pageY);
    }, { passive: true });
    // Scrolling under a still cursor moves the "gaze" across the content.
    window.addEventListener('scroll', () => {
      if (enabled && !heatOpen && lastClient) sample(lastClient.x + window.scrollX, lastClient.y + window.scrollY);
      else kick();
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => { closeLive(performance.now()); lastClient = null; kick(); });
    window.addEventListener('blur', () => { closeLive(performance.now()); kick(); });
    window.addEventListener('resize', () => { closeHeat(); resize(); });
    toggle.addEventListener('click', () => setEnabled(!enabled));
    heatBtn.addEventListener('click', () => (heatOpen ? closeHeat() : openHeat()));
    closeBtn.addEventListener('click', closeHeat);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeHeat(); });
  }
</script>
